# relay-server configuration. Copy to .env (gitignored) and fill in.

PORT=3000

# --- existing relay auth (required) ---
RELAY_TOKEN=change-me-agent-websocket-secret
API_TOKEN=change-me-http-api-token

# --- podcast CMS (optional) ---
# All three must be set or /api/login and /api/podcast/* answer 503.
# CLIENT_PASSWORD is the password the site's "Client Login" modal posts.
CLIENT_PASSWORD=change-me-portal-password
# Supabase project "Media" (ref yatasgixudnowtrzqteu).
SUPABASE_URL=https://yatasgixudnowtrzqteu.supabase.co
# MUST be the service_role key (server-side only; it bypasses RLS).
# Never commit it and never ship it to the browser.
SUPABASE_SERVICE_KEY=
# Public Storage bucket holding episode audio + cover images.
SUPABASE_BUCKET=podcast
# Optional tuning.
# SESSION_TTL_HOURS=12
# MAX_UPLOAD_MB=300

# --- local development only ---
# Serve the static site from this process so the site and its relative
# "/api" calls share one origin. Leave UNSET in production: the webserver
# (LiteSpeed/hPanel) serves the site there.
# SITE_DIR=/home/izzy/SHIP1/shealthmedia-website
